# Nunca introducir secretos reales en este archivo de ejemplo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://politica_canon_app:dev_secret@localhost:5432/politica_canon
EMAIL_WORKER_DATABASE_URL=postgresql://politica_canon_email_worker:worker_dev_secret@localhost:5432/politica_canon
POLITICA_CANON_WORKER_DB_PASS=worker_dev_secret
REDIS_URL=redis://localhost:6379/0

# Claves criptográficas independientes obligatorias (Mínimo 32 caracteres cada una en producción)
SESSION_SECRET=change_in_production_session_secret_32chars_long
MFA_MASTER_KEY=change_in_production_mfa_master_key_32chars_long
EMAIL_OUTBOX_ENCRYPTION_KEY=change_in_production_email_outbox_key_32chars_long
EMAIL_OUTBOX_LEGACY_KEY_V0=optional_legacy_key_v0_for_decrypting_v0.3.25_enc_payloads

# Configuración SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com
SMTP_SECURE=false
