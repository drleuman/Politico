[Unit]
Description=Politica Canon Outbox Worker Service (v0.3.25)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=politica-canon
Group=politica-canon
WorkingDirectory=/opt/politica-canon/app
EnvironmentFile=/etc/politica-canon/runtime.env
Environment=NPM_CONFIG_CACHE=/opt/politica-canon/.npm-cache
ExecStart=/usr/bin/node /opt/politica-canon/app/scripts/email-worker.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/politica-canon

[Install]
WantedBy=multi-user.target
