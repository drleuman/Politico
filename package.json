{
  "name": "politica-canon",
  "version": "0.3.9",
  "description": "Línea base canónica de gobernanza, monolito Fastify y provisión — Política Canon v0.3.9 (Fase 1 MVP)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scratch/copy_public.cjs",
    "start": "node dist/server.js",
    "bootstrap:pre": "node scripts/bootstrap-pre.mjs",
    "migrate:prod": "node scripts/migrate-production.mjs",
    "bootstrap:post": "node scripts/bootstrap-post.mjs",
    "test:integration": "node scripts/test-integration-pg16.mjs",
    "test": "npm run build && node scripts/test-integration-pg16.mjs && node validate_v0.3.9.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0"
  }
}
